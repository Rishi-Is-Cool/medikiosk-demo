# Copy to .env.local. Every value here is optional — the app runs fully on
# mocks with no .env.local at all.

# --- Backend --------------------------------------------------------------
# Leave USE_MOCKS unset (or "true") to run on mock fixtures. For the real
# FastAPI backend set it to false and use API_BASE_URL=/backend — next.config.ts
# proxies /backend/* to KIOSK_BACKEND_ORIGIN (default http://127.0.0.1:8000),
# which is how the patient's phone reaches the API through the kiosk.
NEXT_PUBLIC_USE_MOCKS=true
NEXT_PUBLIC_API_BASE_URL=
# KIOSK_BACKEND_ORIGIN=http://127.0.0.1:8000

# Shows "Skip — use sample answers (demo)" on the question screen, jumping
# straight to document upload. Presentations only — never for real patients.
NEXT_PUBLIC_DEMO_SKIP=false

# --- QR document upload ---------------------------------------------------
# The origin the PATIENT'S PHONE can reach. The kiosk defaults to its own
# window origin, which is "localhost" on a dev machine — a phone cannot resolve
# that, so the QR will not work until you set your LAN address here and start
# the dev server with: npm run dev -- -H 0.0.0.0
# NEXT_PUBLIC_KIOSK_PUBLIC_ORIGIN=http://192.168.1.42:3000

# --- Demo / testing switches ----------------------------------------------
# Forces every speech request to fail, so the "we could not hear that" and
# "Type instead" states can be demonstrated on cue instead of by luck.
NEXT_PUBLIC_MOCK_SPEECH_FAILS=false
