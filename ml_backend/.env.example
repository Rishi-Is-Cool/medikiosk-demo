# MediKiosk AI/ML Backend Environment Config
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Document Upload Constraints
MAX_UPLOAD_SIZE_BYTES=20971520

# AI / Vision LLM Provider ('gemini', 'openai', or 'mock')
VISION_LLM_PROVIDER=gemini
VISION_LLM_API_KEY=your_gemini_api_key_here
VISION_LLM_MODEL=gemini-3.6-flash

# Text Synthesis Provider
TEXT_LLM_PROVIDER=gemini
TEXT_LLM_API_KEY=your_gemini_api_key_here
TEXT_LLM_MODEL=gemini-3.6-flash
