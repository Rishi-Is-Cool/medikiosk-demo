# MediKiosk — shared environment config (backend/, ai/, ml_backend/)
# Copy to .env at the project root and fill in real values. Never commit .env.

# ─── Backend (FastAPI app, auth, DB) ───────────────────────────────────────────
PROJECT_NAME="MediKiosk AI Clinical Intake Backend"
SECRET_KEY=change_me_to_a_long_random_value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./medikiosk.db
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# ─── AI — shared Gemini key used by ai/intake (clinical extraction) and ───────
# ─── ml_backend (document vision extraction, snapshot/Q&A synthesis) ──────────
GEMINI_API_KEY=

# ─── ml_backend — vision LLM provider selection ('gemini', 'openai', or 'mock')
# Falls back to a deterministic mock provider automatically when no key is set.
VISION_LLM_PROVIDER=gemini
VISION_LLM_MODEL=gemini-3.6-flash
TEXT_LLM_PROVIDER=gemini
TEXT_LLM_MODEL=gemini-3.6-flash
MAX_UPLOAD_SIZE_BYTES=20971520

# ─── Local speech transcription (faster-whisper) ───────────────────────────────
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_INITIAL_PROMPT=
