# NOTE: since the AI integration merge, the app loads a shared .env from the
# project root first (../.env — see ../.env.example), which also covers the
# ai/ and ml_backend/ services. This file is kept for running backend/ in
# isolation; a root .env takes precedence for any key defined in both.
PROJECT_NAME="MediKiosk AI Clinical Intake Backend"
SECRET_KEY="change_me_to_a_long_random_value"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL="sqlite:///./medikiosk.db"
GEMINI_API_KEY=""
ENVIRONMENT="development"

# Local speech transcription (faster-whisper)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
